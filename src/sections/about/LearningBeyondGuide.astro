---
// COMPONENTS //
import FaqItem from "@/components/ui/FaqItem.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";

// DATA //
import { learningBeyondFaqs, learningBeyondGuide } from "@/data/about/learning-and-beyond/seo-content";

const { curriculum, campus } = learningBeyondGuide;
---

<section id="learning-beyond-guide" data-section="Learning Beyond Guide">
  <div class="container mx-auto px-6 py-16 lg:py-24 2xl:px-0">
    <div class="mx-auto max-w-4xl space-y-14">
      <!-- Curriculum -->
      <article class="space-y-6">
        <h2
          class="text-2xl leading-snug font-medium text-orange-500 md:text-3xl lg:text-4xl"
        >
          {curriculum.heading}
        </h2>
        {
          curriculum.paragraphs.map((text) => (
            <p class="text-n-600 font-secondary text-base leading-relaxed md:text-lg">
              {text}
            </p>
          ))
        }
      </article>

      <!-- Campus -->
      <article class="space-y-6">
        <h2
          class="text-2xl leading-snug font-medium text-orange-500 md:text-3xl lg:text-4xl"
        >
          {campus.heading}
        </h2>
        {
          campus.paragraphs.map((text) => (
            <p class="text-n-600 font-secondary text-base leading-relaxed md:text-lg">
              {text}
            </p>
          ))
        }
      </article>
    </div>
  </div>
</section>

<section data-section="Learning Beyond FAQ">
  <div class="container mx-auto space-y-10 px-6 pb-16 lg:pb-24">
    <!-- Section header component -->
    <SectionHeader title="Frequently Asked Questions" />

    <div id="faq" class="mx-auto max-w-4xl space-y-2 md:space-y-4">
      {
        learningBeyondFaqs.map((faq, i) => (
          <FaqItem
            question={faq.question}
            answer={faq.answer}
            pointers={faq.pointers}
            isOpen={i === 0}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initFaqAccordions } from "@/scripts/faq-accordion";

  initFaqAccordions();
</script>
