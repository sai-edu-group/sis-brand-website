---
// COMPONENTS //
import ArticleCard from "@/components/ui/ArticleCard.astro";
import SectionHeaderMain from "@/components/ui/SectionHeaderMain.astro";

// CONSTANTS //
import { URLS } from "@/infrastructure/constants/urls";

// DATA //
import { affiliationsDetails } from "@/data/about/affiliations";
import { affiliationsGuide } from "@/data/about/affiliations-seo-content";

/** Board copy shown inside each affiliation card, keyed by card title */
const boardCopy = {
  CBSE: affiliationsGuide.cbse,
  IGCSE: affiliationsGuide.caie,
} as const;
---

<section class="bg-n-100 relative w-full overflow-hidden">
  <div
    class="container mx-auto flex flex-col gap-10 p-6 md:gap-14 md:py-9 md:pb-18 lg:gap-20 lg:pb-24"
  >
    <!-- Section header title and intro -->
    <div class="space-y-4">
      <SectionHeaderMain
        title={affiliationsGuide.h1}
        subtitle={affiliationsDetails.sectionHeaderContent.subtitle}
        titleTag="h1"
      />

      <p
        class="text-n-600 font-secondary max-w-4xl text-base leading-relaxed md:text-lg"
      >
        {affiliationsGuide.intro}
      </p>
    </div>

    <!-- Affiliations Cards wrapper -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:gap-8">
      <!-- Affiliations Cards -->
      {
        affiliationsDetails.affiliationsContent.map(
          (affiliationsContentItem, cardIndex) => {
            const board =
              boardCopy[affiliationsContentItem.title as keyof typeof boardCopy];
            return (
              <div
                class="card-anim card-bottom"
                style={`--delay: ${cardIndex * 0.1}s`}
              >
                <ArticleCard
                  title={board?.heading ?? affiliationsContentItem.title}
                  titleTag="h2"
                  img={affiliationsContentItem.img}
                  objectFit="contain"
                  href={URLS.ABOUT.AFFILIATIONS.ITEM(
                    affiliationsContentItem.title
                      .toLowerCase()
                      .replaceAll("-", " "),
                  )}
                  description={
                    board ? board.paragraphs.join(" ") : affiliationsContentItem.description
                  }
                  badgeText=""
                />
              </div>
            );
          },
        )
      }
    </div>
  </div>
</section>
